# OfficeHours AI — production / AUI CDN env NAMES only (no secret values).
# Inject via the host secrets store. Never commit real .env files.

# --- Sub-path + single-process SPA ---
OFFICEHOURS_ROOT_PATH=/officehours-ai
OFFICEHOURS_SERVE_FRONTEND=true
# OFFICEHOURS_FRONTEND_DIST=

# --- Mode ---
OFFICEHOURS_DEMO=true
# Community later: OFFICEHOURS_DEMO=false

# --- Clustering / embeddings ---
OFFICEHOURS_CLUSTERING_BACKEND=lexical
# OFFICEHOURS_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Set all three only if the MiniLM tar is unpacked under deploy/huggingface
# (or another HF_HOME path). Otherwise leave them unset/commented so the
# first Ask Triage ML classify can reach huggingface.co.
# HF_HOME=
# TRANSFORMERS_OFFLINE=1
# HF_HUB_OFFLINE=1

# --- URLs / CORS ---
OFFICEHOURS_FRONTEND_URL=https://cdn.aui.ma/officehours-ai
OFFICEHOURS_CORS_ORIGINS=https://cdn.aui.ma
OFFICEHOURS_TRUST_PROXY=true
OFFICEHOURS_RATE_LIMIT=true

# --- Database ---
DATABASE_URL=postgresql://officehours:CHANGE_ME@127.0.0.1:5432/officehours
# OFFICEHOURS_DB_POOL_SIZE=5
# OFFICEHOURS_DB_MAX_OVERFLOW=10

# --- Canvas LTI 1.3 (community) ---
# OFFICEHOURS_LTI_ISSUER=
# OFFICEHOURS_LTI_CLIENT_ID=
# OFFICEHOURS_LTI_LAUNCH_URL=https://cdn.aui.ma/officehours-ai/lti/launch
# OFFICEHOURS_LTI_DEPLOYMENT_ID=
# OFFICEHOURS_LTI_AUTH_LOGIN_URL=
# OFFICEHOURS_LTI_JWKS_URL=

# --- Canvas REST ---
# CANVAS_BASE_URL=
# CANVAS_API_TOKEN=
# OFFICEHOURS_CANVAS_MODE=live

# --- Microsoft Entra (optional) ---
# OFFICEHOURS_MS_TENANT_ID=
# OFFICEHOURS_MS_CLIENT_ID=
# OFFICEHOURS_MS_CLIENT_SECRET=
# OFFICEHOURS_MS_REDIRECT_URI=https://cdn.aui.ma/officehours-ai/auth/microsoft/callback
# OFFICEHOURS_MS_ALLOWED_DOMAIN=aui.ma

# --- Optional LLM / Resources (leave unset for empty Resources) ---
# GEMINI_API_KEY=
# PEDAGOGY_GEMINI_API_KEY=
# YOUTUBE_API_KEY=
# ANTHROPIC_API_KEY=
OFFICEHOURS_LLM_ENABLED=false
OFFICEHOURS_ALLOW_EXTERNAL_LLM=false
# OFFICEHOURS_LLM_PROVIDER=
# OFFICEHOURS_GEMINI_FREE_TIER_ACK=false

# --- Optional SMTP ---
# OFFICEHOURS_SMTP_HOST=
# OFFICEHOURS_SMTP_PORT=587
# OFFICEHOURS_SMTP_USER=
# OFFICEHOURS_SMTP_PASSWORD=
# OFFICEHOURS_SMTP_FROM=
# OFFICEHOURS_SMTP_STARTTLS=true
