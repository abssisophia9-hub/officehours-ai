# OfficeHours AI — backend environment template
# Copy to backend/.env. Never commit real secrets.
#
# Local FYP: copy this file, then set ONLY GEMINI_API_KEY (and optional
# ANTHROPIC_API_KEY). Non-secret defaults below are already filled for demo.
# Production / AUI CDN: the host injects env vars; do not rely on a laptop .env.
#
# Full security notes: docs/SECURITY.md
# Canvas live-test: docs/canvas_live_test.md

# --- Local FYP defaults (safe to keep for Sophia's machine) ---
OFFICEHOURS_DEMO=true
OFFICEHOURS_CLUSTERING_BACKEND=lexical
OFFICEHOURS_REVISION_WEB=true
OFFICEHOURS_LLM_ENABLED=true
OFFICEHOURS_ALLOW_EXTERNAL_LLM=true
OFFICEHOURS_LLM_PROVIDER=gemini
OFFICEHOURS_GEMINI_FREE_TIER_ACK=true
# Fill this locally. Never commit a real value.
GEMINI_API_KEY=
# Optional Pedagogy Agent Gemini key; falls back to GEMINI_API_KEY when empty.
PEDAGOGY_GEMINI_API_KEY=
# YouTube Data API v3 (Pedagogy Resources videos). Never commit a real value.
YOUTUBE_API_KEY=
# Optional: article/combined short cache TTL seconds. Default 1800.
# OFFICEHOURS_RESOURCES_CACHE_TTL_SECONDS=1800
# Shared YouTube topic-pool TTL seconds (default 21600 = 6h). Preference is
# applied later by ranking — not by extra search.list calls.
# OFFICEHOURS_YOUTUBE_CACHE_TTL_SECONDS=21600
# Brief TTL after YouTube failures / near-quota blocks. Default 60.
# OFFICEHOURS_RESOURCES_FAILURE_CACHE_TTL_SECONDS=60
# Soft daily caps (official defaults: 100 search.list/day; 10000 other units).
# OFFICEHOURS_YOUTUBE_SEARCH_DAILY_LIMIT=100
# OFFICEHOURS_YOUTUBE_OTHER_UNITS_DAILY_LIMIT=10000
# Optional path for persisted topic cache + quota counters.
# OFFICEHOURS_RESOURCES_CACHE_PATH=

# Optional Claude path (leave blank unless you switch provider to claude)
# ANTHROPIC_API_KEY=
# OFFICEHOURS_LLM_PROVIDER=claude

# --- App URLs (local) ---
OFFICEHOURS_FRONTEND_URL=http://127.0.0.1:5180
# Comma-separated extra SPA origins (CORS allow-list; never "*")
OFFICEHOURS_CORS_ORIGINS=

# --- Sub-path / single-process deploy (AUI CDN) ---
# Leave empty for local Windows scripts (root paths on :8000 / :5180).
# OFFICEHOURS_ROOT_PATH=/officehours-ai
# Serve Vite dist from the same uvicorn (set true on CDN; leave off for FYP).
# OFFICEHOURS_SERVE_FRONTEND=true
# Optional override if dist is not at ../frontend/officehours-app/dist
# OFFICEHOURS_FRONTEND_DIST=

# --- Database ---
# SQLite (default FYP demo) or Postgres for campus
# DATABASE_URL=sqlite:///./officehours.db
# DATABASE_URL=postgresql://officehours:CHANGE_ME@127.0.0.1:5432/officehours
# OFFICEHOURS_DB_POOL_SIZE=5
# OFFICEHOURS_DB_MAX_OVERFLOW=10

# --- Security controls ---
# Rate limit hot paths (login / Quiet ask / Study Agent). Leave on in production.
OFFICEHOURS_RATE_LIMIT=true
# Only set true behind a reverse proxy that overwrites X-Forwarded-For
OFFICEHOURS_TRUST_PROXY=false

# --- Production / AUI CDN overrides (set by the host, not this laptop file) ---
# OFFICEHOURS_DEMO=false
# OFFICEHOURS_LLM_ENABLED=false
# OFFICEHOURS_ALLOW_EXTERNAL_LLM=false
# OFFICEHOURS_LLM_PROVIDER=
# OFFICEHOURS_GEMINI_FREE_TIER_ACK=false
# OFFICEHOURS_FRONTEND_URL=https://officehours.example.edu
# OFFICEHOURS_CORS_ORIGINS=
# Prefer Postgres + live Canvas; leave GEMINI / YOUTUBE unset unless campus
# policy allows them. With OFFICEHOURS_DEMO=false, external Gemini stays blocked
# (do not change that rule). Resources then still attempt keyless Wikipedia /
# trusted-domain article search and YouTube only if YOUTUBE_API_KEY is injected;
# otherwise students see the empty Resources state.

# --- Canvas LTI 1.3 ---
# OFFICEHOURS_LTI_ISSUER=https://canvas.example.edu
# OFFICEHOURS_LTI_CLIENT_ID=
# OFFICEHOURS_LTI_LAUNCH_URL=https://api.example.edu/lti/launch
# OFFICEHOURS_LTI_DEPLOYMENT_ID=
# OFFICEHOURS_LTI_AUTH_LOGIN_URL=
# OFFICEHOURS_LTI_JWKS_URL=

# --- Canvas REST (live modules / files) ---
# Both required for live sync; leave unset to use the local demo mirror when
# OFFICEHOURS_DEMO=true. Token is loaded as a secret — never commit real values.
# CANVAS_BASE_URL=https://aui.instructure.com
# CANVAS_API_TOKEN=replace-with-canvas-api-token
# OFFICEHOURS_CANVAS_MODE=live
# Optional: require secret on unsigned demo launch (still prefer LTI)
# OFFICEHOURS_CANVAS_LAUNCH_SECRET=

# --- Microsoft Entra ID (optional @aui.ma SSO) ---
# OFFICEHOURS_MS_TENANT_ID=
# OFFICEHOURS_MS_CLIENT_ID=
# OFFICEHOURS_MS_CLIENT_SECRET=
# OFFICEHOURS_MS_REDIRECT_URI=https://api.example.edu/auth/microsoft/callback
# OFFICEHOURS_MS_ALLOWED_DOMAIN=aui.ma

# --- Optional SMTP (inbox still works without email) ---
# OFFICEHOURS_SMTP_HOST=
# OFFICEHOURS_SMTP_PORT=587
# OFFICEHOURS_SMTP_USER=
# OFFICEHOURS_SMTP_PASSWORD=
# OFFICEHOURS_SMTP_FROM=
# OFFICEHOURS_SMTP_STARTTLS=true

# --- ML / clustering ---
# OFFICEHOURS_EMBEDDING_MODEL=all-MiniLM-L6-v2
# OFFICEHOURS_CLUSTER_SIMILARITY_THRESHOLD=0.72
# OFFICEHOURS_ALLOW_RETRAIN=false
